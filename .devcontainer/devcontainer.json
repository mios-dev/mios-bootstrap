{
  "name": "mios-bootstrap Installer Dev (Fedora 44)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "FEDORA_VERSION": "44"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "ms-vscode.powershell",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "usernamehw.errorlens",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteUser": "mios-dev",
  "workspaceFolder": "/mios-bootstrap",
  "mounts": [
    "source=${localWorkspaceFolder},target=/mios-bootstrap,type=bind,consistency=cached"
  ],
  "postCreateCommand": "{ git clone --depth 1 https://github.com/mios-dev/-dev-loop.git \"$HOME/.dev-loop\" 2>/dev/null || git -C \"$HOME/.dev-loop\" pull --ff-only 2>/dev/null; } ; bash \"$HOME/.dev-loop/skills/dev-loop/scripts/env/setup-antigravity.sh\" --quiet || true",
  "postStartCommand": "bash -c '. \"$HOME/.dev-loop/skills/dev-loop/scripts/env/agy-keyring.sh\" || true'"
}
