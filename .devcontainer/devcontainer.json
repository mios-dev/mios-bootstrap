{
  "name": "mios-bootstrap Installer Dev (Fedora latest)",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:latest": {
      "username": "mios-dev",
      "userUid": "1000",
      "userGid": "1000",
      "upgradePackages": false
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "git.autoRepositoryDetection": "subFolders",
        "git.repositoryScanMaxDepth": 5,
        "git.openRepositoryInParentFolders": "always",
        "workbench.colorTheme": "Dark Modern",
        "workbench.experimental.modernUI": true,
        "window.titleBarStyle": "custom",
        "window.density.layout": "compact",
        "workbench.layoutControl.enabled": false,
        "workbench.activityBar.location": "top",
        "workbench.statusBar.visible": true,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "workbench.panel.defaultLocation": "bottom",
        "workbench.panel.alignment": "justify",
        "workbench.panel.opensMaximized": "never",
        "workbench.sideBar.location": "left",
        "workbench.editor.openSideBySideDirection": "down",
        "workbench.editor.splitInGroupLayout": "horizontal",
        "workbench.editor.showTabs": "single",
        "workbench.tree.indent": 12,
        "workbench.tree.renderIndentGuides": "none",
        "workbench.tree.expandMode": "singleClick",
        "workbench.list.smoothScrolling": true,
        "explorer.autoReveal": false,
        "zenMode.centerLayout": false,
        "zenMode.hideActivityBar": true,
        "zenMode.showTabs": "single",
        "editor.wordWrap": "on",
        "editor.wordWrapColumn": 80,
        "editor.wrappingStrategy": "advanced",
        "editor.minimap.enabled": false,
        "editor.glyphMargin": false,
        "editor.stickyScroll.enabled": false,
        "editor.lineNumbers": "on",
        "editor.lineNumbersMinChars": 3,
        "editor.showFoldingControls": "never",
        "editor.dragAndDrop": false,
        "editor.fontSize": 16,
        "editor.lineHeight": 24,
        "editor.cursorWidth": 3,
        "editor.cursorBlinking": "smooth",
        "editor.mouseWheelZoom": true,
        "editor.smoothScrolling": true,
        "editor.mouseWheelScrollSensitivity": 2,
        "editor.fastScrollSensitivity": 5,
        "editor.renderWhitespace": "none",
        "editor.guides.indentation": false,
        "editor.overviewRulerBorder": false,
        "editor.scrollbar.verticalScrollbarSize": 14,
        "editor.scrollbar.horizontalScrollbarSize": 10,
        "editor.autoClosingBrackets": "always",
        "editor.autoClosingQuotes": "always",
        "editor.selectionHighlight": false,
        "editor.occurrencesHighlight": "off",
        "terminal.integrated.fontSize": 14,
        "terminal.integrated.lineHeight": 1.1,
        "terminal.integrated.tabs.enabled": false,
        "terminal.integrated.wordWrap": true,
        "terminal.integrated.scrollback": 10000,
        "terminal.integrated.smoothScrolling": true,
        "terminal.integrated.mouseWheelScrollSensitivity": 2,
        "terminal.integrated.gpuAcceleration": "off",
        "breadcrumbs.enabled": true,
        "breadcrumbs.filePath": "last",
        "window.zoomLevel": -0.5,
        "window.commandCenter": false,
        "window.menuBarVisibility": "compact",
        "workbench.editor.tabActionLocation": "left",
        "workbench.editor.labelFormat": "short",
        "workbench.colorCustomizations": {
          "editor.background": "#000000",
          "editor.foreground": "#d0d4d8",
          "editorGutter.background": "#000000",
          "editorLineNumber.foreground": "#5c6470",
          "editorLineNumber.activeForeground": "#aeb7c2",
          "editorCursor.foreground": "#aeb7c2",
          "editorGroup.border": "#16191d",
          "editorGroupHeader.tabsBackground": "#000000",
          "editorGroupHeader.tabsBorder": "#16191d",
          "editorGroupHeader.noTabsBackground": "#000000",
          "editorGroupHeader.border": "#16191d",
          "tab.activeBackground": "#000000",
          "tab.activeForeground": "#d0d4d8",
          "tab.activeBorder": "#405568",
          "tab.activeBorderTop": "#405568",
          "tab.inactiveBackground": "#000000",
          "tab.inactiveForeground": "#747d88",
          "tab.border": "#16191d",
          "tab.unfocusedActiveBackground": "#000000",
          "tab.unfocusedActiveForeground": "#d0d4d8",
          "tab.unfocusedInactiveBackground": "#000000",
          "tab.unfocusedInactiveForeground": "#747d88",
          "sideBar.background": "#000000",
          "sideBar.foreground": "#b9c0c8",
          "sideBar.border": "#16191d",
          "sideBarTitle.foreground": "#d0d4d8",
          "sideBarSectionHeader.background": "#000000",
          "sideBarSectionHeader.foreground": "#b9c0c8",
          "sideBarSectionHeader.border": "#16191d",
          "activityBar.background": "#000000",
          "activityBar.foreground": "#d0d4d8",
          "activityBar.inactiveForeground": "#5c6470",
          "activityBar.border": "#16191d",
          "activityBarBadge.background": "#405568",
          "activityBarBadge.foreground": "#d0d4d8",
          "statusBar.background": "#000000",
          "statusBar.foreground": "#b9c0c8",
          "statusBar.border": "#16191d",
          "statusBar.noFolderBackground": "#000000",
          "statusBar.noFolderForeground": "#b9c0c8",
          "statusBar.noFolderBorder": "#16191d",
          "statusBar.debuggingBackground": "#000000",
          "statusBar.debuggingForeground": "#d0d4d8",
          "statusBar.debuggingBorder": "#16191d",
          "statusBarItem.remoteBackground": "#000000",
          "statusBarItem.remoteForeground": "#d0d4d8",
          "titleBar.activeBackground": "#000000",
          "titleBar.activeForeground": "#b9c0c8",
          "titleBar.inactiveBackground": "#000000",
          "titleBar.inactiveForeground": "#5c6470",
          "titleBar.border": "#16191d",
          "panel.background": "#000000",
          "panel.border": "#16191d",
          "panelTitle.activeForeground": "#d0d4d8",
          "panelTitle.inactiveForeground": "#747d88",
          "panelTitle.activeBorder": "#405568",
          "terminal.background": "#000000",
          "terminal.foreground": "#b9c0c8",
          "terminal.border": "#16191d",
          "terminalCursor.foreground": "#aeb7c2",
          "breadcrumb.background": "#000000",
          "breadcrumb.foreground": "#747d88",
          "breadcrumb.focusForeground": "#d0d4d8",
          "quickInput.background": "#000000",
          "quickInput.foreground": "#b9c0c8",
          "menu.background": "#000000",
          "menu.foreground": "#b9c0c8"
        }
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-python.python",
        "redhat.vscode-podman",
        "redhat.vscode-yaml",
        "ms-vscode.powershell",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "usernamehw.errorlens",
        "editorconfig.editorconfig"
      ]
    },
    "codespaces": {
      "repositories": {
        "mios-dev/MiOS": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write",
            "workflows": "write"
          }
        },
        "mios-dev/mios-bootstrap": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write",
            "workflows": "write"
          }
        },
        "mios-dev/-dev-loop": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write",
            "workflows": "write"
          }
        },
        "mios-dev/mios-micro": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write",
            "workflows": "write"
          }
        }
      }
    }
  },
  "remoteUser": "mios-dev",
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/mios-bootstrap",
  "postCreateCommand": "bash -c 'if [ -f /workspaces/MiOS/.devcontainer/setup-devcontainer.sh ]; then bash /workspaces/MiOS/.devcontainer/setup-devcontainer.sh; else { git clone --depth 1 https://github.com/mios-dev/MiOS.git /workspaces/MiOS 2>/dev/null || true; } && bash /workspaces/MiOS/.devcontainer/setup-devcontainer.sh; fi'",
  "postStartCommand": "bash -c '. /workspaces/-dev-loop/skills/dev-loop/scripts/env/agy-keyring.sh 2>/dev/null || true'",
  "postAttachCommand": "code --execute-command workbench.action.closeSidebar",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  }
}
